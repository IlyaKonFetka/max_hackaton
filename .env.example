# Токен бота MAX (выдан организаторами). Никогда не коммитить реальный токен.
MAX_BOT_TOKEN=
# Ник бота — для ссылок вида https://max.ru/<bot>?start=...
MAX_BOT_USERNAME=t419_hakaton_max_bot
# Публичный HTTPS-адрес этого бэкенда (нужен мини-приложению и для ссылок на фото в акте)
PUBLIC_API_URL=http://localhost:8000
# Разрешённые origin'ы мини-приложения (через запятую)
CORS_ORIGINS=https://ilyakonfetka.github.io,http://localhost:5173
# Где лежат данные (SQLite, фото, акты)
DATA_DIR=./data
# Смещение локального времени для сроков и напоминаний (Москва = 3)
TZ_OFFSET_HOURS=3
# 1 — запускать бота в этом процессе; 0 — только API
RUN_BOT=1
# 1 — принимать заголовок X-Debug-User вместо подписанного initData (ТОЛЬКО локальная разработка)
DEBUG_AUTH=0
PORT=8000
